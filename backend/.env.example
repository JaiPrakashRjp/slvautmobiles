# Copy to .env and fill in your real values. Do NOT commit the real .env.

# PostgreSQL connection (SQLAlchemy URL)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/slv_auto

# App
APP_ENV=development

# CORS: comma-separated allowed origins. Leave as "*" for local dev / the mobile
# APK; set to the real frontend domain(s) in production.
# e.g. CORS_ORIGINS=https://app.slvauto.com,https://admin.slvauto.com
CORS_ORIGINS=*
